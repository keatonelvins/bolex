feature onum {
    sub @lf by @osf;
} onum;

feature lnum {
    sub @osf by @lf;
} lnum;

feature tnum {
    sub @lf by @tf;
} tnum;

feature pnum {
    sub @tf by @lf;
} pnum;

feature numr {
    sub @lf by @num;
    sub @osf by @num;
    sub @tf by @num;
} numr;

feature dnom {
    sub @lf by @den;
    sub @osf by @den;
    sub @tf by @den;
} dnom;

feature frac {
    lookup FRAC_SLASH {
        sub [@lf @osf @tf @num] [slash fraction]' [@lf @osf @tf @den] by fraction.frac;
    } FRAC_SLASH;
    lookup FRAC_NUMR {
        rsub @lf' [fraction.frac @num] by @num;
        rsub @osf' [fraction.frac @num] by @num;
        rsub @tf' [fraction.frac @num] by @num;
    } FRAC_NUMR;
    lookup FRAC_DNOM {
        sub [fraction.frac @den] @lf' by @den;
        sub [fraction.frac @den] @osf' by @den;
        sub [fraction.frac @den] @tf' by @den;
    } FRAC_DNOM;
} frac;
