feature frac {
    lookup FRAC_SLASH {
        sub [@lf @osf @tf @tosf @num] [slash fraction]' [@lf @osf @tf @tosf @den] by fraction.frac;
    } FRAC_SLASH;
    lookup FRAC_NUMR {
        rsub @lf' [fraction.frac @num] by @num;
        rsub @osf' [fraction.frac @num] by @num;
        rsub @tf' [fraction.frac @num] by @num;
        rsub @tosf' [fraction.frac @num] by @num;
    } FRAC_NUMR;
    lookup FRAC_DNOM {
        sub [fraction.frac @den] @lf' by @den;
        sub [fraction.frac @den] @osf' by @den;
        sub [fraction.frac @den] @tf' by @den;
        sub [fraction.frac @den] @tosf' by @den;
    } FRAC_DNOM;
} frac;
