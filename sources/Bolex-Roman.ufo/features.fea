@den = [zero.den one.den two.den three.den four.den five.den six.den seven.den eight.den nine.den];

@sups_num = [zero.num one.num two.num three.num four.num five.num six.num seven.num eight.num nine.num];
feature sups {
    sub @lf by @sups_num;
    sub @osf by @sups_num;
    sub @tf by @sups_num;
} sups;

