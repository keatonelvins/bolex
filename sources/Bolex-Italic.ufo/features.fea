# Generated by tools/features.py -- edit that script, not this file.

languagesystem DFLT dflt;
languagesystem latn dflt;

@lf = [zero one two three four five six seven eight nine];

@sups_num = [zero.num one.num two.num three.num four.num five.num six.num seven.num eight.num nine.num];
feature sups {
    sub @lf by @sups_num;
} sups;

feature liga {
    sub f f i by f_f_i;
    sub f f l by f_f_l;
    sub f f b by f_f_b;
    sub f f h by f_f_h;
    sub f f k by f_f_k;
    sub f f by f_f;
