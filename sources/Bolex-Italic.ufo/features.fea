# Generated by tools/features.py -- edit that script, not this file.

languagesystem DFLT dflt;
languagesystem latn dflt;

@lf = [zero one two three four five six seven eight nine];

@sups_num = [zero.num one.num two.num three.num four.num five.num six.num seven.num eight.num nine.num];
feature sups {
    sub @lf by @sups_num;
} sups;

feature liga {
    sub f f i by f_f_i;
    sub f f l by f_f_l;
    sub f f b by f_f_b;
    sub f f h by f_f_h;
    sub f f k by f_f_k;
    sub f f by f_f;
    sub f i by f_i;
    sub f j by f_j;
    sub f l by f_l;
    sub f b by f_b;
    sub f h by f_h;
    sub f k by f_k;
} liga;

@f_full_before = [A AE Aacute Acircumflex Adieresis Agrave Aring Atilde B C Ccedilla D E Eacute Ecircumflex Edieresis Egrave Eth F G H I Iacute Idieresis Igrave J K L M N Ntilde O OE Oacute Ocircumflex Odieresis Ograve Oslash Otilde P Q R S Scaron Thorn U Uacute Ucircumflex Udieresis Ugrave V W X Y Yacute Ydieresis Z Zcaron a aacute acircumflex adieresis ae agrave aring atilde c caron ccedilla circumflex d dotlessi e eacute ecircumflex edieresis egrave eth f f_b f_f f_f.short f_f_b f_f_h f_f_i f_f_k f_f_l f_h f_i f_j f_k f_l fi fl g germandbls i iacute icircumflex idieresis j m mu n ntilde o oacute ocircumflex odieresis oe ograve ordfeminine ordmasculine oslash otilde p q r s scaron t thorn u uacute ucircumflex udieresis ugrave uni02BB uni02BC v w x y yacute ydieresis z zcaron];

feature calt {
    ignore sub f' @f_full_before;
    ignore sub f_f' @f_full_before;
    sub f' by f.short;
    sub f_f' by f_f.short;
} calt;

feature case {
    sub braceleft by braceleft.case;
    sub braceright by braceright.case;
    sub bracketleft by bracketleft.case;
    sub bracketright by bracketright.case;
    sub emdash by emdash.case;
    sub endash by endash.case;
    sub guillemotleft by guillemotleft.case;
    sub guillemotright by guillemotright.case;
    sub guilsinglleft by guilsinglleft.case;
    sub guilsinglright by guilsinglright.case;
    sub hyphen by hyphen.case;
    sub parenleft by parenleft.case;
    sub parenright by parenright.case;
} case;
